# Google OAuth Credentials
# You must obtain these by creating a project at https://console.cloud.google.com
# 1. Create Project -> APIs & Services -> Credentials
# 2. Create OAuth Client ID (Web Application)
# 3. Add Authorized Redirect URI (e.g. https://your-app.onrender.com/auth/callback)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Security Key for JWTs and Session Cookies
# In production, run `openssl rand -hex 32` and paste it here
SECRET_KEY=super-secret-local-dev-key

# Database and Redis Connections (Render will inject these automatically)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
# REDIS_URL=redis://hostname:6379
